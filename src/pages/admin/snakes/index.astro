---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import { actions } from 'astro:actions';
import { env } from 'cloudflare:workers';
import { createDb } from '../../../db/client';
import { listSpecimens } from '../../../db/specimens';
import { formatPrice, getSpecimenStatus, getStatusLabel, isDemoSpecimen, specimenImageAlt, specimenImageUrl } from '../../../lib/specimens';

const db = createDb((env as unknown as Env).DB);
const deleteResult = Astro.getActionResult(actions.deleteSnake);
if (deleteResult && !deleteResult.error) {
  return Astro.redirect('/admin/snakes?removed=1', 303);
}

const specimens = await listSpecimens(db);
const removed = Astro.url.searchParams.has('removed');
---

<AdminLayout title="Specimens">
  <div slot="header-actions">
    <Button href="/admin/snakes/new" size="sm">Add specimen</Button>
  </div>

  <div class="mx-auto max-w-7xl">
    <div class="mb-8">
      <p class="eyebrow">Collection management</p>
      <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface">Specimen registry</h2>
      <p class="mt-3 text-on-surface-variant">
        {specimens.length} {specimens.length === 1 ? 'specimen' : 'specimens'} recorded.
      </p>
    </div>

    {removed && (
      <div role="status" class="mb-6 rounded-md bg-secondary-container px-4 py-3 text-sm text-secondary">
        Specimen removed.
      </div>
    )}
    {deleteResult?.error && (
      <div role="alert" class="mb-6 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
        {deleteResult.error.message}
      </div>
    )}

    {specimens.length === 0 ? (
      <section class="surface-panel flex min-h-80 flex-col items-center justify-center p-8 text-center">
        <img src="/placeholder-snake.svg" alt="" class="h-24 w-24 opacity-40" />
        <h3 class="mt-5 font-noto-serif text-2xl font-bold text-on-surface">Start your collection</h3>
        <p class="mt-2 max-w-md text-sm text-on-surface-variant">
          Add the first specimen and its public page will be ready with a neutral image placeholder.
        </p>
        <Button href="/admin/snakes/new" class="mt-6">Add first specimen</Button>
      </section>
    ) : (
      <div class="overflow-hidden rounded-lg bg-surface-container-low">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px]">
            <thead class="bg-surface-container">
              <tr>
                <th scope="col" class="px-5 py-4 text-left text-xs font-semibold text-on-surface-variant">Specimen</th>
                <th scope="col" class="px-5 py-4 text-left text-xs font-semibold text-on-surface-variant">Status</th>
                <th scope="col" class="px-5 py-4 text-left text-xs font-semibold text-on-surface-variant">Traits</th>
                <th scope="col" class="px-5 py-4 text-left text-xs font-semibold text-on-surface-variant">Price</th>
                <th scope="col" class="px-5 py-4 text-right text-xs font-semibold text-on-surface-variant">Actions</th>
              </tr>
            </thead>
            <tbody>
              {specimens.map((specimen) => {
                const status = getSpecimenStatus(specimen);
                return (
                  <tr class="odd:bg-surface-container-low even:bg-surface-container">
                    <td class="px-5 py-4">
                      <div class="flex items-center gap-3">
                        <img
                          src={specimenImageUrl(specimen)}
                          alt={specimenImageAlt(specimen)}
                          class="h-12 w-12 rounded-md bg-surface-container-lowest object-cover"
                        />
                        <div>
                          <div class="flex flex-wrap items-center gap-2">
                            <a href={`/admin/snakes/${specimen.id}/edit`} class="font-semibold text-on-surface hover:text-primary">
                              {specimen.name}
                            </a>
                            {isDemoSpecimen(specimen) && <Badge variant="demo">Demo</Badge>}
                          </div>
                          <p class="mt-1 text-xs text-on-surface-variant">{specimen.species}</p>
                        </div>
                      </div>
                    </td>
                    <td class="px-5 py-4"><Badge variant={status}>{getStatusLabel(status)}</Badge></td>
                    <td class="px-5 py-4 text-sm text-on-surface-variant">
                      {specimen.traits.length ? specimen.traits.map((trait) => trait.label).join(', ') : 'Not recorded'}
                    </td>
                    <td class="px-5 py-4 text-sm text-on-surface">{formatPrice(specimen.priceInCents) ?? 'Inquire'}</td>
                    <td class="px-5 py-4">
                      <div class="flex items-center justify-end gap-2">
                        <Button href={`/snakes/${specimen.slug}`} variant="ghost" size="sm">View</Button>
                        <Button href={`/admin/snakes/${specimen.id}/edit`} variant="secondary" size="sm">Edit</Button>
                        <form method="POST" action={actions.deleteSnake} data-confirm-delete>
                          <input type="hidden" name="id" value={specimen.id} />
                          <input type="hidden" name="confirm" value="delete" />
                          <Button type="submit" variant="ghost" size="sm" ariaLabel={`Remove ${specimen.name}`}>Remove</Button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-confirm-delete]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        if (!window.confirm('Permanently remove this specimen? This cannot be undone.')) {
          event.preventDefault();
        }
      });
    });
  </script>
</AdminLayout>
