---
interface Props {
  label: string;
  name: string;
  required?: boolean;
  error?: string | string[];
  hint?: string;
}

const { label, name, required = false, error, hint } = Astro.props;
const message = Array.isArray(error) ? error[0] : error;
---

<div>
  <label for={name} class="field-label">
    {label}{required && <span aria-hidden="true" class="ml-1 text-primary">*</span>}
  </label>
  <slot />
  {hint && !message && <p class="mt-1.5 text-xs text-on-surface-variant">{hint}</p>}
  {message && (
    <p id={`${name}-error`} role="alert" class="mt-1.5 text-xs text-danger">{message}</p>
  )}
</div>
