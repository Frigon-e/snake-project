---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Chip from '../../components/ui/Chip.astro';
import FormField from '../../components/ui/FormField.astro';
import Input from '../../components/ui/Input.astro';
import ComplementaryGenetics from '../../components/snakes/ComplementaryGenetics.astro';
import { actions, isInputError } from 'astro:actions';
import { env } from 'cloudflare:workers';
import { createDb } from '../../db/client';
import { getSpecimenBySlug } from '../../db/specimens';
import {
  formatPrice,
  formatHatchDate,
  getSpecimenStatus,
  getStatusLabel,
  isDemoSpecimen,
  specimenImageAlt,
  specimenImageUrl,
} from '../../lib/specimens';

const { slug } = Astro.params;
const db = createDb((env as unknown as Env).DB);
const specimen = slug ? await getSpecimenBySlug(db, slug) : null;
if (!specimen) return Astro.rewrite('/404');

const inquiryResult = Astro.getActionResult(actions.submitInquiry);
if (inquiryResult && !inquiryResult.error) {
  return Astro.redirect(`/snakes/${specimen.slug}?inquiry=sent#inquiry`, 303);
}
const inquiryErrors = inquiryResult?.error && isInputError(inquiryResult.error)
  ? inquiryResult.error.fields
  : {};

const status = getSpecimenStatus(specimen);
const price = formatPrice(specimen.priceInCents);
const imageUrl = specimenImageUrl(specimen);
const sent = Astro.url.searchParams.get('inquiry') === 'sent';
const hatchDate = formatHatchDate(specimen.hatchDate);
const isDemo = isDemoSpecimen(specimen);
const facts = [
  specimen.sex && { label: 'Sex', value: specimen.sex },
  hatchDate && {
    label: 'Hatched',
    value: hatchDate,
  },
  specimen.weightGrams && { label: 'Weight', value: `${specimen.weightGrams} g` },
  specimen.diet && { label: 'Current diet', value: specimen.diet },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title={specimen.name} description={specimen.description || `${specimen.name}, ${specimen.species}.`}>
  <Header slot="header" />

  <article class="page-shell py-10 sm:py-16">
    <a href="/snakes" class="text-sm font-semibold text-on-surface-variant hover:text-primary">
      <span aria-hidden="true">←</span> Back to the collection
    </a>

    <header class="mt-7 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant={status}>{getStatusLabel(status)}</Badge>
          {isDemo && <Badge variant="demo">Demo specimen</Badge>}
          <span class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant">{specimen.species}</span>
        </div>
        <h1 class="mt-4 font-noto-serif text-5xl font-bold leading-tight text-on-surface sm:text-6xl">{specimen.name}</h1>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant">Price</p>
        <p class="mt-1 font-noto-serif text-3xl font-bold text-on-surface">{price ?? 'Inquire'}</p>
      </div>
    </header>

    {isDemo && (
      <aside class="mt-6 rounded-lg bg-secondary-container px-5 py-4 text-sm leading-relaxed text-secondary" aria-label="Demo specimen notice">
        This is a fictional demonstration record used to preview the website. It is not a real animal or an offer for sale.
      </aside>
    )}

    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
      <div class="overflow-hidden rounded-lg bg-surface-container-lowest">
        <img
          src={imageUrl}
          alt={specimenImageAlt(specimen)}
          class:list={[
            'aspect-[4/3] h-full w-full',
            specimen.primaryImageKey ? 'object-cover' : 'object-contain p-20 opacity-45',
          ]}
        />
      </div>

      <aside class="surface-panel p-5 sm:p-7" aria-labelledby="details-heading">
        <h2 id="details-heading" class="font-noto-serif text-2xl font-bold text-on-surface">Specimen details</h2>
        {facts.length > 0 ? (
          <dl class="mt-5 grid gap-3">
            {facts.map((fact) => (
              <div class="rounded-md bg-surface-container px-4 py-3">
                <dt class="text-xs font-semibold text-on-surface-variant">{fact.label}</dt>
                <dd class="mt-1 text-sm font-medium capitalize text-on-surface">{fact.value}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">
            Additional measurements have not been recorded yet. Ask for the latest details below.
          </p>
        )}
        {specimen.traits.length > 0 && (
          <div class="mt-6">
            <h3 class="text-sm font-semibold text-on-surface">Recorded genetics</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {specimen.traits.map((trait) => <Chip type={trait.type}>{trait.label}</Chip>)}
            </div>
          </div>
        )}
        <a href="#inquiry" class:list={[
          'mt-7 flex min-h-12 items-center justify-center rounded-md px-5 text-sm font-bold',
          status === 'available'
            ? 'bg-primary text-on-primary hover:bg-primary/90'
            : 'bg-surface-container-high text-on-surface hover:bg-surface-container-highest',
        ]}>
          {status === 'available' ? 'Ask about this specimen' : 'Ask about future availability'}
        </a>
        <p class="mt-3 text-center text-xs leading-relaxed text-on-surface-variant">
          An inquiry is a conversation, not a reservation or purchase.
        </p>
      </aside>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section class="surface-panel p-5 sm:p-7" aria-labelledby="overview-heading">
        <p class="eyebrow">Overview</p>
        <h2 id="overview-heading" class="mt-2 font-noto-serif text-2xl font-bold text-on-surface">About {specimen.name}</h2>
        <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-on-surface-variant">
          {specimen.description || 'A fuller description has not been added yet. Please use the inquiry form for current details.'}
        </p>
      </section>

      <section class="surface-panel p-5 sm:p-7" aria-labelledby="care-heading">
        <p class="eyebrow">Care notes</p>
        <h2 id="care-heading" class="mt-2 font-noto-serif text-2xl font-bold text-on-surface">Temperament & husbandry</h2>
        {specimen.personality || specimen.feedingNotes || specimen.shedFrequency || specimen.temperature || specimen.humidity ? (
          <dl class="mt-4 grid gap-4 text-sm">
            {specimen.personality && <div><dt class="font-semibold text-on-surface">Temperament</dt><dd class="mt-1 text-on-surface-variant">{specimen.personality}</dd></div>}
            {specimen.feedingNotes && <div><dt class="font-semibold text-on-surface">Feeding</dt><dd class="mt-1 text-on-surface-variant">{specimen.feedingNotes}</dd></div>}
            {specimen.shedFrequency && <div><dt class="font-semibold text-on-surface">Shedding</dt><dd class="mt-1 text-on-surface-variant">{specimen.shedFrequency}</dd></div>}
            {specimen.temperature && <div><dt class="font-semibold text-on-surface">Temperature</dt><dd class="mt-1 text-on-surface-variant">{specimen.temperature}</dd></div>}
            {specimen.humidity && <div><dt class="font-semibold text-on-surface">Humidity</dt><dd class="mt-1 text-on-surface-variant">{specimen.humidity}</dd></div>}
          </dl>
        ) : (
          <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">Care notes are available on request.</p>
        )}
      </section>
    </div>

    {specimen.complementaryGenetics && (
      <div class="mt-6">
        <ComplementaryGenetics server:defer geneticsText={specimen.complementaryGenetics} />
      </div>
    )}

    <section id="inquiry" class="surface-panel-raised mt-10 scroll-mt-24 p-5 sm:p-8" aria-labelledby="inquiry-heading">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
        <div>
          <p class="eyebrow">Direct inquiry</p>
          <h2 id="inquiry-heading" class="mt-2 font-noto-serif text-3xl font-bold text-on-surface">Ask about {specimen.name}</h2>
          <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">
            Share a little about what you would like to know. Your message is stored with this specimen so it does not get lost.
          </p>
        </div>

        <div>
          {sent && (
            <div role="status" class="mb-5 rounded-md bg-secondary-container px-4 py-3 text-sm text-secondary">
              Thanks—your inquiry was received.
            </div>
          )}
          {inquiryResult?.error && !isInputError(inquiryResult.error) && (
            <div role="alert" class="mb-5 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
              {inquiryResult.error.message}
            </div>
          )}
          <form method="POST" action={actions.submitInquiry} class="grid gap-5">
            <input type="hidden" name="snakeId" value={specimen.id} />
            <div class="absolute -left-[10000px]" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <FormField label="Your name" name="name" required error={inquiryErrors.name}>
                <Input name="name" required error={inquiryErrors.name} autocomplete="name" />
              </FormField>
              <FormField label="Email address" name="email" required error={inquiryErrors.email}>
                <Input name="email" type="email" required error={inquiryErrors.email} autocomplete="email" />
              </FormField>
            </div>
            <FormField label="Question" name="message" required error={inquiryErrors.message}>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="field-control resize-y"
                aria-invalid={inquiryErrors.message ? 'true' : undefined}
                aria-describedby={inquiryErrors.message ? 'message-error' : undefined}
                placeholder="What would you like to know about this specimen?"
              ></textarea>
            </FormField>
            <Button type="submit" class="w-full sm:w-auto">
              Send inquiry
            </Button>
          </form>
        </div>
      </div>
    </section>
  </article>

  <Footer slot="footer" />
</BaseLayout>
