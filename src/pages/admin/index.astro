---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { env } from 'cloudflare:workers';
import { and, count, eq, isNull, or } from 'drizzle-orm';
import { createDb } from '../../db/client';
import { inquiries, snakes } from '../../db/schema';
import { listSpecimens } from '../../db/specimens';
import { formatPrice, getSpecimenStatus, getStatusLabel, specimenImageAlt, specimenImageUrl } from '../../lib/specimens';

const db = createDb((env as unknown as Env).DB);
const [[{ value: specimenCount }], [{ value: availableCount }], [{ value: inquiryCount }], recent] =
  await Promise.all([
    db.select({ value: count() }).from(snakes),
    db
      .select({ value: count() })
      .from(snakes)
      .where(or(
        eq(snakes.status, 'available'),
        and(isNull(snakes.status), eq(snakes.available, true)),
      )),
    db.select({ value: count() }).from(inquiries),
    listSpecimens(db, { limit: 5 }),
  ]);
---

<AdminLayout title="Overview">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Owner workspace</p>
        <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface">Collection overview</h2>
        <p class="mt-3 text-on-surface-variant">A quick look at your hand-managed collection and messages.</p>
      </div>
      <Button href="/admin/snakes/new">Add specimen</Button>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <a href="/admin/snakes" class="surface-panel p-5 transition-colors hover:bg-surface-container-high">
        <p class="text-sm text-on-surface-variant">Total specimens</p>
        <p class="mt-2 font-noto-serif text-4xl font-bold text-on-surface">{specimenCount}</p>
      </a>
      <a href="/admin/snakes" class="surface-panel p-5 transition-colors hover:bg-surface-container-high">
        <p class="text-sm text-on-surface-variant">Available now</p>
        <p class="mt-2 font-noto-serif text-4xl font-bold text-primary">{availableCount}</p>
      </a>
      <a href="/admin/inquiries" class="surface-panel p-5 transition-colors hover:bg-surface-container-high">
        <p class="text-sm text-on-surface-variant">Customer inquiries</p>
        <p class="mt-2 font-noto-serif text-4xl font-bold text-on-surface">{inquiryCount}</p>
      </a>
    </div>

    <section class="mt-8 overflow-hidden rounded-lg bg-surface-container-low" aria-labelledby="recent-heading">
      <div class="flex items-center justify-between gap-4 bg-surface-container px-5 py-4">
        <h3 id="recent-heading" class="font-noto-serif text-xl font-bold text-on-surface">Recently added</h3>
        <a href="/admin/snakes" class="text-sm font-semibold text-primary hover:text-primary/80">View all</a>
      </div>

      {recent.length === 0 ? (
        <div class="p-10 text-center">
          <img src="/placeholder-snake.svg" alt="" class="mx-auto h-20 w-20 opacity-40" />
          <p class="mt-4 text-on-surface-variant">No specimens have been added yet.</p>
          <Button href="/admin/snakes/new" class="mt-5">Add first specimen</Button>
        </div>
      ) : (
        <div class="divide-y divide-transparent">
          {recent.map((specimen) => {
            const status = getSpecimenStatus(specimen);
            return (
              <a
                href={`/admin/snakes/${specimen.id}/edit`}
                class="grid gap-4 bg-surface-container-low px-5 py-4 transition-colors hover:bg-surface-container-high sm:grid-cols-[1fr_auto_auto] sm:items-center"
              >
                <div class="flex items-center gap-3">
                  <img
                    src={specimenImageUrl(specimen)}
                    alt={specimenImageAlt(specimen)}
                    class="h-12 w-12 rounded-md bg-surface-container-lowest object-cover"
                  />
                  <div>
                    <p class="font-semibold text-on-surface">{specimen.name}</p>
                    <p class="mt-1 text-xs text-on-surface-variant">{specimen.species}</p>
                  </div>
                </div>
                <Badge variant={status}>{getStatusLabel(status)}</Badge>
                <span class="text-sm text-on-surface">{formatPrice(specimen.priceInCents) ?? 'Inquire'}</span>
              </a>
            );
          })}
        </div>
      )}
    </section>
  </div>
</AdminLayout>
