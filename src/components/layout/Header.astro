---
const pathname = Astro.url.pathname;
const links = [
  { href: '/snakes', label: 'Collection', active: pathname.startsWith('/snakes') },
  { href: '/#about', label: 'About', active: false },
  { href: '/#contact', label: 'Contact', active: false },
];
---

<header class="sticky top-0 z-50 bg-surface/80 backdrop-blur-xl">
  <div class="page-shell flex h-[68px] items-center justify-between gap-4">
    <a href="/" class="rounded-md font-noto-serif text-xl font-bold tracking-tight text-on-surface sm:text-2xl">
      BC Exotix
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-2 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-semibold transition-colors',
            link.active
              ? 'bg-surface-container-high text-primary'
              : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/admin"
        class="ml-2 rounded-md px-3 py-2 text-xs font-semibold text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface"
      >
        Owner sign in
      </a>
    </nav>

    <details class="group relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md bg-surface-container-high text-on-surface">
        <span class="sr-only">Open navigation</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <nav aria-label="Mobile navigation" class="absolute right-0 mt-3 flex w-56 flex-col gap-1 rounded-lg bg-surface-container p-2 shadow-ambient">
        {links.map((link) => (
          <a href={link.href} class="rounded-md px-3 py-3 text-sm font-semibold text-on-surface hover:bg-surface-container-high">
            {link.label}
          </a>
        ))}
        <a href="/admin" class="rounded-md px-3 py-3 text-sm text-on-surface-variant hover:bg-surface-container-high">
          Owner sign in
        </a>
      </nav>
    </details>
  </div>
</header>
