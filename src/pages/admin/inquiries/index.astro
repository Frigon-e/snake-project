---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import { env } from 'cloudflare:workers';
import { desc, eq } from 'drizzle-orm';
import { createDb } from '../../../db/client';
import { inquiries, snakes } from '../../../db/schema';

const db = createDb((env as unknown as Env).DB);
const messages = await db
  .select({
    inquiry: inquiries,
    specimenName: snakes.name,
    specimenSlug: snakes.slug,
  })
  .from(inquiries)
  .leftJoin(snakes, eq(inquiries.snakeId, snakes.id))
  .orderBy(desc(inquiries.createdAt));
---

<AdminLayout title="Inquiries">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8">
      <p class="eyebrow">Customer messages</p>
      <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface">Inquiries</h2>
      <p class="mt-3 text-on-surface-variant">
        Questions submitted from specimen pages. Reply using the customer's email address.
      </p>
    </div>

    {messages.length === 0 ? (
      <section class="surface-panel p-10 text-center">
        <h3 class="font-noto-serif text-2xl font-bold text-on-surface">No inquiries yet</h3>
        <p class="mt-2 text-sm text-on-surface-variant">New messages will appear here.</p>
      </section>
    ) : (
      <div class="space-y-4">
        {messages.map(({ inquiry, specimenName, specimenSlug }) => (
          <article class="surface-panel p-5 sm:p-7">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-semibold text-on-surface">{inquiry.name}</h3>
                <a href={`mailto:${inquiry.email}`} class="mt-1 block text-sm text-primary hover:text-primary/80">{inquiry.email}</a>
              </div>
              <Badge>{inquiry.createdAt ? inquiry.createdAt.toLocaleDateString('en-CA') : 'New'}</Badge>
            </div>
            {specimenName && specimenSlug && (
              <a href={`/snakes/${specimenSlug}`} class="mt-4 inline-flex text-xs font-semibold text-secondary hover:text-primary">
                About {specimenName}
              </a>
            )}
            <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-on-surface-variant">{inquiry.message}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
