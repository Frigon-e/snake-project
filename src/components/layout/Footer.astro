---
const year = new Date().getFullYear();
---

<footer class="bg-surface-container-low">
  <div class="page-shell grid gap-10 py-12 sm:grid-cols-[1fr_auto] sm:items-end">
    <div class="max-w-md">
      <p class="font-noto-serif text-xl font-bold text-on-surface">BC Exotix</p>
      <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
        A small, home-based collection focused on healthy animals, clear records, and thoughtful placements.
      </p>
    </div>
    <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
      <a href="/snakes" class="text-on-surface-variant hover:text-primary">Collection</a>
      <a href="/#about" class="text-on-surface-variant hover:text-primary">About</a>
      <a href="/#contact" class="text-on-surface-variant hover:text-primary">Contact</a>
    </nav>
    <p class="text-xs text-on-surface-variant sm:col-span-2">
      &copy; {year} BC Exotix. Availability is updated by hand.
    </p>
  </div>
</footer>
