---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import SpecimenForm from '../../../../components/admin/SpecimenForm.astro';
import Badge from '../../../../components/ui/Badge.astro';
import Button from '../../../../components/ui/Button.astro';
import { actions, isInputError } from 'astro:actions';
import { env } from 'cloudflare:workers';
import { createDb } from '../../../../db/client';
import { getSpecimenById } from '../../../../db/specimens';
import { getSpecimenStatus, getStatusLabel, isDemoSpecimen, specimenImageAlt, specimenImageUrl } from '../../../../lib/specimens';

const { id } = Astro.params;
const db = createDb((env as unknown as Env).DB);
const specimen = id ? await getSpecimenById(db, id) : null;
if (!specimen) return Astro.redirect('/admin/snakes');

const updateResult = Astro.getActionResult(actions.updateSnake);
const addTraitResult = Astro.getActionResult(actions.addTrait);
const deleteTraitResult = Astro.getActionResult(actions.deleteTrait);
const deleteResult = Astro.getActionResult(actions.deleteSnake);

if (updateResult && !updateResult.error) {
  return Astro.redirect(`/admin/snakes/${specimen.id}/edit?saved=1`, 303);
}
if (addTraitResult && !addTraitResult.error) {
  return Astro.redirect(`/admin/snakes/${specimen.id}/edit?trait=added`, 303);
}
if (deleteTraitResult && !deleteTraitResult.error) {
  return Astro.redirect(`/admin/snakes/${specimen.id}/edit?trait=removed`, 303);
}
if (deleteResult && !deleteResult.error) {
  return Astro.redirect('/admin/snakes?removed=1', 303);
}

const fieldErrors = updateResult?.error && isInputError(updateResult.error)
  ? updateResult.error.fields
  : {};
const saved = Astro.url.searchParams.has('saved');
const created = Astro.url.searchParams.has('created');
const status = getSpecimenStatus(specimen);
const isDemo = isDemoSpecimen(specimen);
---

<AdminLayout title={`Edit ${specimen.name}`}>
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <p class="eyebrow">Collection management</p>
          {isDemo && <Badge variant="demo">Demo</Badge>}
          <Badge variant={status}>{getStatusLabel(status)}</Badge>
        </div>
        <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface">{specimen.name}</h2>
        <a href={`/snakes/${specimen.slug}`} class="mt-2 inline-flex text-sm text-primary hover:text-primary/80">
          View public page
        </a>
      </div>
      <Button type="submit" form="specimen-form">Save changes</Button>
    </div>

    {(saved || created) && (
      <div role="status" class="mb-6 rounded-md bg-secondary-container px-4 py-3 text-sm text-secondary">
        {created ? 'Specimen added. You can now add its genetic traits.' : 'Changes saved.'}
      </div>
    )}
    {updateResult?.error && !isInputError(updateResult.error) && (
      <div role="alert" class="mb-6 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
        {updateResult.error.message}
      </div>
    )}

    <div class="mb-6 overflow-hidden rounded-lg bg-surface-container-low">
      <div class="grid gap-5 p-5 sm:grid-cols-[10rem_1fr] sm:items-center">
        <img
          src={specimenImageUrl(specimen)}
          alt={specimenImageAlt(specimen)}
          class="aspect-[4/3] w-full rounded-md bg-surface-container-lowest object-cover"
        />
        <div>
          <p class="text-sm font-semibold text-on-surface">Current public image</p>
          <p class="mt-1 text-sm text-on-surface-variant">
            {specimen.primaryImageKey ? 'The stored R2 image is shown on public cards and detail pages.' : 'A neutral placeholder is shown until an image key is added.'}
          </p>
        </div>
      </div>
    </div>

    <SpecimenForm
      action={actions.updateSnake}
      mode="edit"
      specimen={specimen}
      fieldErrors={fieldErrors}
      restoreDraft={Boolean(updateResult?.error)}
    />

    <section class="surface-panel mt-8 p-5 sm:p-7" aria-labelledby="traits-heading">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="eyebrow">Genetics</p>
          <h3 id="traits-heading" class="mt-2 font-noto-serif text-2xl font-bold text-on-surface">Traits</h3>
        </div>
        <form method="POST" action={actions.addTrait} class="grid gap-3 sm:grid-cols-[1fr_auto_auto]">
          <input type="hidden" name="snakeId" value={specimen.id} />
          <label>
            <span class="sr-only">Trait name</span>
            <input name="label" required maxlength="60" class="field-control" placeholder="Trait name" />
          </label>
          <label>
            <span class="sr-only">Inheritance type</span>
            <select name="type" class="field-control">
              <option value="dominant">Dominant</option>
              <option value="recessive">Recessive</option>
              <option value="codominant">Co-dominant</option>
            </select>
          </label>
          <Button type="submit" size="sm">Add trait</Button>
        </form>
      </div>

      {addTraitResult?.error && (
        <div role="alert" class="mt-5 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
          {isInputError(addTraitResult.error)
            ? addTraitResult.error.fields.label?.[0] ?? 'Check the trait details and try again.'
            : addTraitResult.error.message}
        </div>
      )}
      {deleteTraitResult?.error && (
        <div role="alert" class="mt-5 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
          {deleteTraitResult.error.message}
        </div>
      )}

      <div class="mt-5 flex flex-wrap gap-2">
        {specimen.traits.map((trait) => (
          <form method="POST" action={actions.deleteTrait}>
            <input type="hidden" name="id" value={trait.id} />
            <Button
              type="submit"
              size="sm"
              variant="secondary"
              class="rounded-full hover:bg-danger-container hover:text-danger"
              ariaLabel={`Remove ${trait.label} trait`}
            >
              {trait.label} <span aria-hidden="true">×</span>
            </Button>
          </form>
        ))}
        {specimen.traits.length === 0 && (
          <p class="text-sm text-on-surface-variant">No genetic traits recorded yet.</p>
        )}
      </div>
    </section>

    <section class="mt-8 rounded-lg bg-danger-container/60 p-5 sm:p-7" aria-labelledby="remove-heading">
      <h3 id="remove-heading" class="font-semibold text-danger">Permanently remove this specimen</h3>
      <p class="mt-2 max-w-2xl text-sm text-on-surface-variant">
        This also removes its traits. Existing inquiry messages are kept without the specimen link.
      </p>
      <form method="POST" action={actions.deleteSnake} class="mt-4" data-confirm-delete>
        <input type="hidden" name="id" value={specimen.id} />
        <input type="hidden" name="confirm" value="delete" />
        <Button type="submit" variant="destructive">Remove specimen</Button>
      </form>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-confirm-delete]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        if (!window.confirm('Permanently remove this specimen? This cannot be undone.')) {
          event.preventDefault();
        }
      });
    });
  </script>
</AdminLayout>
