---
interface Props {
  name: string;
  id?: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  value?: string | number;
  error?: string | string[];
  class?: string;
  min?: string | number;
  max?: string | number;
  step?: string | number;
  autocomplete?: string;
}

const {
  name,
  id = name,
  type = 'text',
  placeholder,
  required,
  value,
  error,
  class: className = '',
  min,
  max,
  step,
  autocomplete,
} = Astro.props;
const hasError = Boolean(error);
---

<input
  id={id}
  name={name}
  type={type as astroHTML.JSX.HTMLInputTypeAttribute}
  placeholder={placeholder}
  required={required}
  value={value}
  min={min}
  max={max}
  step={step}
  autocomplete={autocomplete}
  aria-invalid={hasError ? 'true' : undefined}
  aria-describedby={hasError ? `${id}-error` : undefined}
  class={`field-control ${className}`}
/>
