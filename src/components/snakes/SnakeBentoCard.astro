---
import Badge from '../ui/Badge.astro';
import type { SpecimenWithTraits } from '../../db/specimens';
import {
  formatPrice,
  getSpecimenStatus,
  getStatusLabel,
  isDemoSpecimen,
  specimenImageAlt,
  specimenImageUrl,
} from '../../lib/specimens';

interface Props {
  snake: SpecimenWithTraits;
  variant: 'large' | 'small' | 'horizontal';
}

const { snake, variant } = Astro.props;
const status = getSpecimenStatus(snake);
const price = formatPrice(snake.priceInCents);
const isDemo = isDemoSpecimen(snake);
---

<a
  href={`/snakes/${snake.slug}`}
  class:list={[
    'group relative block h-full overflow-hidden rounded-lg bg-surface-container-low focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-primary',
    variant === 'large' && 'min-h-[30rem]',
    variant === 'small' && 'min-h-[24rem]',
    variant === 'horizontal' && 'min-h-[22rem]',
  ]}
>
  <img
    src={specimenImageUrl(snake)}
    alt={specimenImageAlt(snake)}
    class:list={[
      'absolute inset-0 h-full w-full transition-transform duration-700 group-hover:scale-[1.03]',
      snake.primaryImageKey ? 'object-cover' : 'object-contain p-20 opacity-35',
    ]}
    loading="lazy"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/25 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2">
      <Badge variant={status}>{getStatusLabel(status)}</Badge>
      {isDemo && <Badge variant="demo">Demo</Badge>}
      {snake.featured && <Badge variant="featured">Featured</Badge>}
    </div>
    <div class="mt-4 flex items-end justify-between gap-4">
      <div>
        <h3 class:list={['font-noto-serif font-bold text-on-surface', variant === 'large' ? 'text-3xl' : 'text-2xl']}>
          {snake.name}
        </h3>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-primary">{snake.species}</p>
      </div>
      <span class="shrink-0 text-sm font-semibold text-on-surface">{price ?? 'Inquire'}</span>
    </div>
  </div>
</a>
