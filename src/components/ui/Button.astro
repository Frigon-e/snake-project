---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'outline' | 'ghost' | 'destructive';
  size?: 'sm' | 'default' | 'lg' | 'icon';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  class?: string;
  disabled?: boolean;
  form?: string;
  ariaLabel?: string;
  id?: string;
}

const {
  variant = 'primary',
  size = 'default',
  type = 'button',
  href,
  class: className = '',
  disabled = false,
  form,
  ariaLabel,
  id,
} = Astro.props;

const base =
  'inline-flex shrink-0 items-center justify-center gap-2 rounded-md font-semibold transition-colors disabled:pointer-events-none disabled:opacity-50';
const variants = {
  primary: 'bg-primary text-on-primary hover:bg-primary/90',
  secondary: 'bg-surface-container-high text-on-surface hover:bg-surface-container-highest',
  accent: 'bg-tertiary text-on-tertiary hover:bg-tertiary/90',
  outline: 'border border-outline-variant/50 bg-transparent text-on-surface hover:bg-surface-container-high',
  ghost: 'bg-transparent text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface',
  destructive: 'bg-danger-container text-danger hover:bg-danger-container/80',
};
const sizes = {
  sm: 'min-h-11 px-3 text-xs',
  default: 'h-11 px-4 text-sm',
  lg: 'h-12 px-6 text-sm',
  icon: 'h-11 w-11',
};
const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{href ? (
  <a
    href={disabled ? undefined : href}
    class={classes}
    aria-disabled={disabled ? 'true' : undefined}
    aria-label={ariaLabel}
    id={id}
  >
    <slot />
  </a>
) : (
  <button id={id} type={type} disabled={disabled} class={classes} form={form} aria-label={ariaLabel}>
    <slot />
  </button>
)}
