---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SnakeBentoGrid from '../components/snakes/SnakeBentoGrid.astro';
import Button from '../components/ui/Button.astro';
import { env } from 'cloudflare:workers';
import { createDb } from '../db/client';
import { listSpecimens } from '../db/specimens';

const db = createDb((env as unknown as Env).DB);
const featured = await listSpecimens(db, { featuredOnly: true, limit: 4 });
const fallbackCollection = featured.length ? featured : await listSpecimens(db, { limit: 4 });
---

<BaseLayout title="Home" description="BC Exotix is a small, home-based snake breeding collection.">
  <Header slot="header" />

  <section class="relative flex min-h-[calc(100svh-68px)] items-center overflow-hidden bg-surface">
    <img src="/demo/hero-bg.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-55" aria-hidden="true" />
    <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/85 to-surface/20"></div>
    <div class="page-shell relative py-20">
      <div class="max-w-3xl">
        <p class="eyebrow">Small collection · Thoughtful placements</p>
        <h1 class="mt-5 font-noto-serif text-5xl font-bold leading-[0.98] tracking-tight text-on-surface sm:text-7xl lg:text-8xl">
          Healthy snakes,<br /><span class="text-primary">clearly presented.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-relaxed text-on-surface-variant sm:text-lg">
          BC Exotix is a home-based breeding project. We keep the collection intentionally small so each available
          animal can be documented and placed with care.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/snakes" size="lg">Browse the collection <span aria-hidden="true">→</span></Button>
          <Button href="/#about" variant="outline" size="lg">How we work</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-container-low py-16 sm:py-24" aria-labelledby="featured-heading">
    <div class="page-shell">
      <div class="mb-10 flex flex-col gap-5 sm:mb-14 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">The collection</p>
          <h2 id="featured-heading" class="mt-3 font-noto-serif text-4xl font-bold text-on-surface sm:text-5xl">
            {fallbackCollection.length ? 'Specimens to discover' : 'A collection in progress'}
          </h2>
          <p class="mt-4 leading-relaxed text-on-surface-variant">
            Availability changes naturally with a small breeding program. Every listing is updated by hand.
          </p>
        </div>
        <a href="/snakes" class="text-sm font-semibold text-primary hover:text-primary/80">
          View the full collection <span aria-hidden="true">→</span>
        </a>
      </div>

      {fallbackCollection.length ? (
        <SnakeBentoGrid snakes={fallbackCollection} />
      ) : (
        <div class="surface-panel-raised grid gap-8 p-6 sm:grid-cols-[12rem_1fr] sm:items-center sm:p-10">
          <img src="/placeholder-snake.svg" alt="" class="mx-auto h-36 w-36 opacity-50" />
          <div>
            <h3 class="font-noto-serif text-3xl font-bold text-on-surface">No public specimens just yet</h3>
            <p class="mt-3 max-w-xl leading-relaxed text-on-surface-variant">
              The neutral image marks records that are still being prepared. It never stands in for a real animal photo.
            </p>
            <Button href="/snakes" variant="secondary" class="mt-6">Check collection status</Button>
          </div>
        </div>
      )}
    </div>
  </section>

  <section id="about" class="py-16 sm:py-28">
    <div class="page-shell grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div class="overflow-hidden rounded-lg bg-surface-container-low">
        <img
          src="/demo/about-facility.jpg"
          alt="A carefully prepared reptile habitat"
          class="aspect-[4/3] h-full w-full object-cover opacity-85"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <p class="eyebrow">A deliberately small program</p>
        <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface sm:text-5xl">Care before scale.</h2>
        <div class="mt-6 space-y-4 leading-relaxed text-on-surface-variant">
          <p>
            This is a home business, not a warehouse. The smaller scale makes room for close observation, practical
            records, and honest conversations with prospective keepers.
          </p>
          <p>
            Listings focus on what helps you decide: genetics, temperament, feeding notes, size, and current availability.
            If something is not recorded, the site says so instead of filling the gap with a claim.
          </p>
        </div>
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="surface-panel p-5">
            <dt class="text-sm font-semibold text-on-surface">Clear records</dt>
            <dd class="mt-2 text-sm leading-relaxed text-on-surface-variant">Useful details stay attached to each individual specimen.</dd>
          </div>
          <div class="surface-panel p-5">
            <dt class="text-sm font-semibold text-on-surface">Personal contact</dt>
            <dd class="mt-2 text-sm leading-relaxed text-on-surface-variant">Questions go directly through the specimen's inquiry form.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-surface-container-high py-16 sm:py-24">
    <div class="page-shell text-center">
      <p class="eyebrow">Start with the right animal</p>
      <h2 class="mx-auto mt-3 max-w-3xl font-noto-serif text-4xl font-bold text-on-surface sm:text-5xl">
        Browse first, then ask anything.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-on-surface-variant">
        Each specimen page has a short inquiry form, so your question arrives with the correct animal attached.
      </p>
      <Button href="/snakes" size="lg" class="mt-8">Find a specimen</Button>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
