---
import SnakeBentoCard from './SnakeBentoCard.astro';
import SnakeGrid from './SnakeGrid.astro';
import type { SpecimenWithTraits } from '../../db/specimens';

interface Props {
  snakes: SpecimenWithTraits[];
}

const { snakes } = Astro.props;
const [large, small, horizontal, fourth] = snakes;
---

{snakes.length < 3 ? (
  <SnakeGrid snakes={snakes} />
) : (
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
    <div class="lg:col-span-8"><SnakeBentoCard snake={large} variant="large" /></div>
    <div class="lg:col-span-4"><SnakeBentoCard snake={small} variant="small" /></div>
    <div class="lg:col-span-7"><SnakeBentoCard snake={horizontal} variant="horizontal" /></div>
    {fourth && <div class="lg:col-span-5"><SnakeBentoCard snake={fourth} variant="small" /></div>}
  </div>
)}
