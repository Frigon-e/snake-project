---
import Badge from '../ui/Badge.astro';
import Chip from '../ui/Chip.astro';
import type { SpecimenWithTraits } from '../../db/specimens';
import {
  formatPrice,
  getSpecimenStatus,
  getStatusLabel,
  isDemoSpecimen,
  specimenImageAlt,
  specimenImageUrl,
} from '../../lib/specimens';

interface Props {
  snake: SpecimenWithTraits;
}

const { snake } = Astro.props;
const status = getSpecimenStatus(snake);
const price = formatPrice(snake.priceInCents);
const isDemo = isDemoSpecimen(snake);
---

<article class="group overflow-hidden rounded-lg bg-surface-container-low transition-colors hover:bg-surface-container-high focus-within:bg-surface-container-high">
  <a
    href={`/snakes/${snake.slug}`}
    class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-primary"
  >
    <div class="aspect-[4/3] overflow-hidden bg-surface-container-lowest">
      <img
        src={specimenImageUrl(snake)}
        alt={specimenImageAlt(snake)}
        class:list={[
          'h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]',
          !snake.primaryImageKey && 'p-12 opacity-45',
        ]}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="font-noto-serif text-xl font-bold leading-snug text-on-surface">{snake.name}</h2>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-primary">{snake.species}</p>
        </div>
        <div class="flex flex-wrap justify-end gap-2">
          {isDemo && <Badge variant="demo">Demo</Badge>}
          <Badge variant={status}>{getStatusLabel(status)}</Badge>
        </div>
      </div>
      {snake.description && (
        <p class="mt-4 line-clamp-2 text-sm leading-relaxed text-on-surface-variant">{snake.description}</p>
      )}
      {snake.traits.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {snake.traits.slice(0, 4).map((trait) => <Chip type={trait.type}>{trait.label}</Chip>)}
        </div>
      )}
      <div class="mt-5 flex items-center justify-between gap-3">
        <span class="text-sm font-semibold text-on-surface">{price ?? 'Inquire for price'}</span>
        <span class="text-sm font-semibold text-primary">View details <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </a>
</article>
