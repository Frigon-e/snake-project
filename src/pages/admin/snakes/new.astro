---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SpecimenForm from '../../../components/admin/SpecimenForm.astro';
import { actions, isInputError } from 'astro:actions';

const result = Astro.getActionResult(actions.createSnake);
if (result && !result.error) {
  return Astro.redirect(`/admin/snakes/${result.data.snake.id}/edit?created=1`, 303);
}
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
---

<AdminLayout title="Add specimen">
  <div class="mx-auto max-w-4xl">
    <div class="mb-8">
      <p class="eyebrow">Collection management</p>
      <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface">Add a specimen</h2>
      <p class="mt-3 max-w-2xl text-on-surface-variant">
        Add the useful details now. You can attach genetic traits after the specimen is created.
      </p>
    </div>

    {result?.error && !isInputError(result.error) && (
      <div role="alert" class="mb-6 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
        {result.error.message}
      </div>
    )}

    <SpecimenForm
      action={actions.createSnake}
      mode="create"
      fieldErrors={fieldErrors}
      restoreDraft={Boolean(result?.error)}
    />
  </div>
</AdminLayout>
