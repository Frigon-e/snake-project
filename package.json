{
  "name": "snake-project",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply bc-exotix-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply bc-exotix-db --remote",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/mdx": "^7.0.5",
    "@clerk/astro": "^4.0.4",
    "@clerk/ui": "^1.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.1.6",
    "drizzle-orm": "^0.45.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@playwright/test": "^1.58.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.116.0"
  }
}
