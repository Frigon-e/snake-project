---
import BaseLayout from './BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { UserButton } from '@clerk/astro/components';

interface Props {
  title: string;
  noPadding?: boolean;
}

const { title, noPadding = false } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { label: 'Overview', href: '/admin', active: pathname === '/admin' },
  { label: 'Specimens', href: '/admin/snakes', active: pathname.startsWith('/admin/snakes') },
  { label: 'Inquiries', href: '/admin/inquiries', active: pathname.startsWith('/admin/inquiries') },
  { label: 'Media', href: '/admin/media', active: pathname.startsWith('/admin/media') },
  { label: 'Settings', href: '/admin/settings', active: pathname.startsWith('/admin/settings') },
];
---

<BaseLayout title={`Admin — ${title}`} description="BC Exotix private collection management.">
  <div class="min-h-screen bg-surface lg:grid lg:grid-cols-[15rem_1fr]">
    <aside aria-label="Admin navigation" class="hidden min-h-screen flex-col bg-surface-container-low lg:flex">
      <div class="p-5">
        <a href="/" class="block rounded-md p-2 hover:bg-surface-container-high">
          <span class="font-noto-serif text-lg font-bold text-on-surface">BC Exotix</span>
          <span class="mt-1 block text-[0.6875rem] uppercase tracking-[0.16em] text-on-surface-variant">
            Owner workspace
          </span>
        </a>
      </div>
      <nav class="flex flex-1 flex-col gap-1 px-3" aria-label="Admin sections">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-3 text-sm font-semibold transition-colors',
              item.active
                ? 'bg-surface-container-high text-primary'
                : 'text-on-surface-variant hover:bg-surface-container hover:text-on-surface',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="bg-surface-container-lowest p-4">
        <Button href="/admin/snakes/new" class="w-full">Add specimen</Button>
        <a href="/" class="mt-3 block rounded-md px-3 py-2 text-center text-xs text-on-surface-variant hover:text-on-surface">
          View storefront
        </a>
      </div>
    </aside>

    <div class="min-w-0">
      <header class="sticky top-0 z-40 flex min-h-16 items-center justify-between gap-4 bg-surface/85 px-4 backdrop-blur-xl sm:px-6">
        <div class="flex min-w-0 items-center gap-3">
          <details class="relative lg:hidden">
            <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-md bg-surface-container-high">
              <span class="sr-only">Open admin navigation</span>
              <span aria-hidden="true">☰</span>
            </summary>
            <nav class="absolute left-0 mt-3 flex w-56 flex-col gap-1 rounded-lg bg-surface-container p-2 shadow-ambient">
              {navItems.map((item) => (
                <a href={item.href} class="rounded-md px-3 py-3 text-sm text-on-surface hover:bg-surface-container-high">
                  {item.label}
                </a>
              ))}
              <a href="/" class="rounded-md px-3 py-3 text-sm text-on-surface-variant hover:bg-surface-container-high">
                View storefront
              </a>
            </nav>
          </details>
          <h1 class="truncate font-noto-serif text-xl font-bold text-on-surface">{title}</h1>
        </div>
        <div class="flex items-center gap-3">
          <slot name="header-actions" />
          <UserButton userProfileUrl="/admin/settings" />
        </div>
      </header>

      <section
        aria-label={title}
        class:list={[
          'min-h-[calc(100vh-4rem)]',
          noPadding ? '' : 'px-4 py-8 sm:px-6 lg:px-10 lg:py-10',
        ]}
      >
        <slot />
      </section>
    </div>
  </div>
</BaseLayout>
