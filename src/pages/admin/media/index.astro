---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import { actions, isInputError } from 'astro:actions';

const result = Astro.getActionResult(actions.uploadMedia);
if (result && !result.error) {
  return Astro.redirect(`/admin/media?uploaded=${encodeURIComponent(result.data.key)}`, 303);
}
const uploadedKey = Astro.url.searchParams.get('uploaded');
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
---

<AdminLayout title="Media">
  <div class="mx-auto max-w-4xl">
    <div class="mb-8">
      <p class="eyebrow">Image storage</p>
      <h2 class="mt-3 font-noto-serif text-4xl font-bold text-on-surface">Specimen media</h2>
      <p class="mt-3 text-on-surface-variant">
        Upload one representative photo, then paste its key into a specimen record.
      </p>
    </div>

    {uploadedKey && (
      <section class="surface-panel mb-6 p-5 sm:p-7" aria-labelledby="uploaded-heading">
        <p class="eyebrow">Upload complete</p>
        <h3 id="uploaded-heading" class="mt-2 font-noto-serif text-2xl font-bold text-on-surface">Image ready to use</h3>
        <img
          src={`/api/r2/image?key=${encodeURIComponent(uploadedKey)}`}
          alt="Newly uploaded specimen"
          class="mt-5 aspect-video w-full max-w-lg rounded-md bg-surface-container-lowest object-contain"
        />
        <label for="uploaded-key" class="field-label mt-5">R2 image key</label>
        <div class="flex flex-col gap-3 sm:flex-row">
          <input id="uploaded-key" readonly value={uploadedKey} class="field-control font-mono text-xs" />
          <Button type="button" variant="secondary" id="copy-key">Copy key</Button>
        </div>
      </section>
    )}

    {result?.error && !isInputError(result.error) && (
      <div role="alert" class="mb-6 rounded-md bg-danger-container px-4 py-3 text-sm text-danger">
        {result.error.message}
      </div>
    )}

    <section class="surface-panel p-5 sm:p-7" aria-labelledby="upload-heading">
      <h3 id="upload-heading" class="font-noto-serif text-2xl font-bold text-on-surface">Upload an image</h3>
      <p class="mt-2 text-sm text-on-surface-variant">JPG, PNG, or WebP up to 10 MB.</p>
      <form method="POST" enctype="multipart/form-data" action={actions.uploadMedia} class="mt-6">
        <label for="file" class="field-label">Choose image</label>
        <input
          id="file"
          type="file"
          name="file"
          accept="image/jpeg,image/png,image/webp"
          required
          class="field-control file:mr-4 file:rounded-md file:border-0 file:bg-surface-container-high file:px-3 file:py-1 file:text-on-surface"
          aria-invalid={fieldErrors.file ? 'true' : undefined}
          aria-describedby={fieldErrors.file ? 'file-error' : undefined}
        />
        {fieldErrors.file?.[0] && (
          <p id="file-error" class="mt-1.5 text-xs text-danger">{fieldErrors.file[0]}</p>
        )}
        <Button type="submit" class="mt-5 w-full sm:w-auto">Upload image</Button>
      </form>
    </section>
  </div>

  {uploadedKey && (
    <script>
      const button = document.querySelector<HTMLButtonElement>('#copy-key');
      const input = document.querySelector<HTMLInputElement>('#uploaded-key');
      button?.addEventListener('click', async () => {
        if (!input) return;
        await navigator.clipboard.writeText(input.value);
        button.textContent = 'Copied';
      });
    </script>
  )}
</AdminLayout>
